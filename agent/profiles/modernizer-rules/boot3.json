{
  "id": "boot3",
  "description": "Deterministic follow-ups after the Spring Boot 3.5 OpenRewrite recipes. Every rule is anchored and idempotent.",
  "javaxToJakarta": true,
  "jakartaRecipe": {
    "artifact": "rewrite-migrate-java",
    "recipe": "org.openrewrite.java.migrate.jakarta.JavaxMigrationToJakarta"
  },
  "dependencyRenames": [],
  "propertyRenames": [
    { "from": "logging.file", "to": "logging.file.name" },
    { "from": "spring.resources.static-locations", "to": "spring.web.resources.static-locations" },
    { "from": "spring.http.encoding.charset", "to": "server.servlet.encoding.charset" }
  ],
  "removeProperties": []
}
