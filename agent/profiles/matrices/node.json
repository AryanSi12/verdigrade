{
  "$comment": "Node.js / TypeScript matrix: supported targets, routes, pinned package versions and pinned codemods. Validated with zod at startup (bot/lib/adapters/nodeMatrix.ts, shared envelope in bot/lib/matrixBase.ts). Run `npx leapfrog validate` after editing. Versions checked against the npm registry and the Node.js release schedule on 2026-11-13.",
  "ecosystem": "node",
  "schemaVersion": 1,
  "tools": {
    "codemodCli": "codemod@1.18.7"
  },
  "defaults": { "node": "24", "typescript": "6.0" },
  "supportedNodeTargets": [
    { "id": "22", "label": "Node 22 LTS (maintenance, end of life 2027-04-30)" },
    { "id": "24", "label": "Node 24 LTS (maintenance, end of life 2028-04-30)" },
    { "id": "26", "label": "Node 26 LTS (active, end of life 2029-04-30)" }
  ],
  "supportedTypescriptTargets": [
    { "id": "5.9", "label": "TypeScript 5.9 (last 5.x)" },
    { "id": "6.0", "label": "TypeScript 6.0 (bridge to the native 7.x compiler)" }
  ],
  "codemods": {
    "express-v5": {
      "package": "@expressjs/v5-migration-recipe@1.1.0",
      "when": "expressBelow5",
      "description": "Official Express 4 → 5 codemod recipe (req.param, res.send(status), redirect('back'), app.del, pluralized accepts*, sendfile, static mime, package.json)."
    }
  },
  "tsconfigProfiles": {
    "5.9": {
      "description": "No tsconfig changes are required for TypeScript 5.9.",
      "removeOptions": [],
      "migrateModuleResolution": false,
      "dropBaseUrlWithoutPaths": false,
      "ensureTypes": false,
      "minimumTarget": null
    },
    "6.0": {
      "description": "TypeScript 6.0 deprecations: moduleResolution node/node10/classic, downlevelIteration, baseUrl and target es3/es5; `types` now defaults to [] so @types packages must be listed.",
      "removeOptions": ["downlevelIteration"],
      "migrateModuleResolution": true,
      "dropBaseUrlWithoutPaths": true,
      "ensureTypes": true,
      "minimumTarget": "es2015"
    }
  },
  "routes": [
    {
      "id": "to-node24-ts6",
      "description": "Node 16–22 → Node 24 LTS, TypeScript 4.x/5.x → 6.0, Express 4 → 5 when Express is used (default)",
      "node": "24",
      "typescript": "6.0",
      "fromNode": ["14", "16", "18", "20", "22", "24"],
      "engines": ">=24",
      "nvmrc": "24",
      "tsconfigProfile": "6.0",
      "codemods": ["express-v5"],
      "packages": [
        { "name": "typescript", "version": "~6.0.3", "when": "present" },
        { "name": "@types/node", "version": "^24.19.2", "when": "present" },
        { "name": "express", "version": "^5.3.0", "when": "belowMajor", "major": 5 },
        { "name": "@types/express", "version": "^5.0.6", "when": "belowMajor", "major": 5 }
      ]
    },
    {
      "id": "to-node26-ts6",
      "description": "Node 16–24 → Node 26 LTS (active), TypeScript 4.x/5.x → 6.0, Express 4 → 5 when Express is used",
      "node": "26",
      "typescript": "6.0",
      "fromNode": ["14", "16", "18", "20", "22", "24", "26"],
      "engines": ">=26",
      "nvmrc": "26",
      "tsconfigProfile": "6.0",
      "codemods": ["express-v5"],
      "packages": [
        { "name": "typescript", "version": "~6.0.3", "when": "present" },
        { "name": "@types/node", "version": "^26.6.6", "when": "present" },
        { "name": "express", "version": "^5.3.0", "when": "belowMajor", "major": 5 },
        { "name": "@types/express", "version": "^5.0.6", "when": "belowMajor", "major": 5 }
      ]
    },
    {
      "id": "to-node24-ts5",
      "description": "Node 16–22 → Node 24 LTS, TypeScript 4.x → 5.9 (smaller step), Express 4 → 5 when Express is used",
      "node": "24",
      "typescript": "5.9",
      "fromNode": ["14", "16", "18", "20", "22", "24"],
      "engines": ">=24",
      "nvmrc": "24",
      "tsconfigProfile": "5.9",
      "codemods": ["express-v5"],
      "packages": [
        { "name": "typescript", "version": "~5.9.3", "when": "present" },
        { "name": "@types/node", "version": "^24.19.2", "when": "present" },
        { "name": "express", "version": "^5.3.0", "when": "belowMajor", "major": 5 },
        { "name": "@types/express", "version": "^5.0.6", "when": "belowMajor", "major": 5 }
      ]
    },
    {
      "id": "to-node22-ts5",
      "description": "Node 14–20 → Node 22 LTS (maintenance until 2027-04), TypeScript 4.x → 5.9, Express 4 → 5 when Express is used",
      "node": "22",
      "typescript": "5.9",
      "fromNode": ["14", "16", "18", "20", "22"],
      "engines": ">=22",
      "nvmrc": "22",
      "tsconfigProfile": "5.9",
      "codemods": ["express-v5"],
      "packages": [
        { "name": "typescript", "version": "~5.9.3", "when": "present" },
        { "name": "@types/node", "version": "^22.20.5", "when": "present" },
        { "name": "express", "version": "^5.3.0", "when": "belowMajor", "major": 5 },
        { "name": "@types/express", "version": "^5.0.6", "when": "belowMajor", "major": 5 }
      ]
    }
  ]
}
